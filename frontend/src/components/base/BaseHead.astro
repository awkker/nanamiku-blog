---
/**
 * 全站 Head 组件
 *
 * 这个文件是 Astro 页面头部信息的统一入口，主要做 3 件事：
 * 1. 引入全局样式，让所有页面都能拿到基础变量和通用样式
 * 2. 输出 SEO / Open Graph / Twitter 所需的静态元信息
 * 3. 在浏览器端做两类“运行时补充”：
 *    - 先同步主题模式，避免页面首屏亮暗闪烁
 *    - 再把后台动态站点资料（标题、描述、品牌名等）写回到 document
 *
 * 所以它既处理“构建期的默认值”，也处理“运行时的动态覆盖”。
 */
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../../styles/global.css';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../../assets/blog-placeholder-1.jpg';
import { SITE_DEFAULT_OG_IMAGE, SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

interface Props {
	// 页面自己的标题和描述是必填项。
	// 这样每个页面都必须明确声明自己在搜索引擎和分享卡片里怎么展示。
	title: string;
	description: string;
	image?: ImageMetadata | string;
	type?: 'website' | 'article';
	publishedTime?: Date | string;
	modifiedTime?: Date | string;
	tags?: string[];
	robots?: string;
}

// canonical URL 表示“当前页面的规范地址”。
// 搜索引擎会用它来避免把同一内容的多个地址当成重复页面。
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url);

const {
	title,
	description,
	image = SITE_DEFAULT_OG_IMAGE,
	type = 'website',
	publishedTime,
	modifiedTime,
	tags = [],
	robots,
} = Astro.props;

function resolveImageURL(value: ImageMetadata | string): URL {
	// 页面可以传 Astro 图片对象，也可以直接传字符串路径。
	// 这里统一把它转成绝对 URL，方便后面的 OG/Twitter 元信息直接使用。
	const src = typeof value === 'string' ? value : value?.src || FallbackImage.src;
	return new URL(src, Astro.site ?? Astro.url);
}

function toISODate(value?: Date | string): string | undefined {
	// 文章发布时间这类字段对搜索引擎更友好的是 ISO 字符串。
	// 这里把 Date / string 两种输入统一整理成标准格式。
	if (!value) {
		return undefined;
	}

	if (value instanceof Date) {
		return value.toISOString();
	}

	const parsed = new Date(value);
	return Number.isNaN(parsed.valueOf()) ? undefined : parsed.toISOString();
}

const socialImageURL = resolveImageURL(image);
const publishedISO = toISODate(publishedTime);
const modifiedISO = toISODate(modifiedTime);
const usesDefaultDescription = description === SITE_DESCRIPTION;
const usesDefaultSocialImage = (typeof image === 'string' ? image : image?.src || FallbackImage.src) === SITE_DEFAULT_OG_IMAGE;
const faviconVersion = '20260402';
---

<script is:inline>
  (() => {
    try {
      const root = document.documentElement;
      // 主题值会提前从 localStorage 取出并写回到 html 节点。
      // 这样在 Vue 岛屿挂载前，页面就已经处于正确主题，不会出现闪一下的情况。
      const mode = window.localStorage.getItem('miku_blog_theme_mode') === 'night' ? 'night' : 'light';
      root.classList.toggle('theme-night', mode === 'night');
      root.setAttribute('data-theme', mode);
    } catch {
      // keep light mode fallback
    }
  })();
</script>

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/png" sizes="32x32" href={`/favicon.png?v=${faviconVersion}`} />
<link rel="icon" type="image/png" sizes="64x64" href={`/favicon.png?v=${faviconVersion}`} />
<link rel="apple-touch-icon" href={`/favicon.png?v=${faviconVersion}`} />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
	data-site-rss-link
/>
<meta name="generator" content={Astro.generator} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} data-site-canonical />

<!-- Primary Meta Tags -->
<title data-site-original={title}>{title}</title>
<meta name="title" content={title} data-site-title-meta data-site-original={title} />
<meta
	name="description"
	content={description}
	data-site-description-meta
	data-site-original={description}
	data-site-uses-default={usesDefaultDescription ? 'true' : 'false'}
/>
{robots && <meta name="robots" content={robots} />}

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={Astro.url} data-site-og-url />
<meta property="og:title" content={title} data-site-title-meta data-site-original={title} />
<meta
	property="og:description"
	content={description}
	data-site-description-meta
	data-site-original={description}
	data-site-uses-default={usesDefaultDescription ? 'true' : 'false'}
/>
<meta
	property="og:image"
	content={socialImageURL}
	data-site-image-meta
	data-site-original={socialImageURL.toString()}
	data-site-uses-default={usesDefaultSocialImage ? 'true' : 'false'}
/>
{type === 'article' && publishedISO && <meta property="article:published_time" content={publishedISO} />}
{type === 'article' && modifiedISO && <meta property="article:modified_time" content={modifiedISO} />}
{type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} data-site-twitter-url />
<meta property="twitter:title" content={title} data-site-title-meta data-site-original={title} />
<meta
	property="twitter:description"
	content={description}
	data-site-description-meta
	data-site-original={description}
	data-site-uses-default={usesDefaultDescription ? 'true' : 'false'}
/>
<meta
	property="twitter:image"
	content={socialImageURL}
	data-site-image-meta
	data-site-original={socialImageURL.toString()}
	data-site-uses-default={usesDefaultSocialImage ? 'true' : 'false'}
/>

<script type="module">
  import { syncSiteProfileIntoDocument } from '../../lib/site-profile-runtime';

  // 构建期产出的 meta 只是默认值。
  // 真正上线后，站点标题/描述/Logo 可能会被后台配置覆盖，
  // 所以这里在客户端再同步一遍运行时资料到 document。
  void syncSiteProfileIntoDocument();
</script>

<script is:inline>
  (() => {
    if (typeof window === 'undefined') return;
    if (navigator.doNotTrack === '1') return;

    const path = window.location.pathname || '/';
    if (path.startsWith('/admin') || path.startsWith('/login') || path.startsWith('/api')) {
      return;
    }

    // 下面这段是一个非常轻量的访问埋点：
    // - 给访客分配一个 30 分钟有效的 session id
    // - 上报当前页面路径、标题、来源、时区等基础信息
    // - 尽量使用 sendBeacon，减少页面跳转时的丢包
    const SESSION_KEY = 'miku_analytics_sid';
    const LAST_ACTIVE_KEY = 'miku_analytics_sid_last';
    const SESSION_TTL_MS = 30 * 60 * 1000;
    const now = Date.now();

    const createSessionId = () => {
      if (window.crypto && typeof window.crypto.randomUUID === 'function') {
        return window.crypto.randomUUID();
      }
      return `sid-${now}-${Math.random().toString(16).slice(2)}`;
    };

    let sessionId = '';
    try {
      const lastActiveRaw = window.localStorage.getItem(LAST_ACTIVE_KEY) || '0';
      const lastActive = Number(lastActiveRaw) || 0;
      const existed = window.localStorage.getItem(SESSION_KEY) || '';
      if (!existed || now - lastActive > SESSION_TTL_MS) {
        sessionId = createSessionId();
        window.localStorage.setItem(SESSION_KEY, sessionId);
      } else {
        sessionId = existed;
      }
      window.localStorage.setItem(LAST_ACTIVE_KEY, String(now));
    } catch {
      sessionId = createSessionId();
    }

    const payload = {
      session_key: sessionId,
      path: window.location.pathname || '/',
      title: document.title || '',
      referrer: document.referrer || '',
      timezone: Intl.DateTimeFormat().resolvedOptions().timeZone || '',
      language: navigator.language || '',
      occurred_at: new Date().toISOString(),
    };

    const endpoint = '/api/v1/analytics/collect';
    const body = JSON.stringify(payload);

    try {
      if (navigator.sendBeacon) {
        const blob = new Blob([body], { type: 'application/json' });
        navigator.sendBeacon(endpoint, blob);
        return;
      }
      fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body,
        keepalive: true,
        credentials: 'include',
      }).catch(() => {});
    } catch {
      // ignore analytics errors
    }
  })();
</script>
