---
import { siteCopy } from '../../content/copy'

interface Props {
  threshold?: number
}

const { threshold = 360 } = Astro.props
---

<button
  type="button"
  class="back-to-top-rocket fixed bottom-6 right-5 z-40 rounded-[18px] border border-miku/35 bg-[linear-gradient(160deg,rgba(255,255,255,0.96),rgba(229,253,249,0.92))] p-2.5 text-miku shadow-[0_12px_28px_rgba(15,23,42,0.18)] backdrop-blur transition hover:-translate-y-0.5 hover:border-miku/60"
  data-back-to-top
  data-threshold={threshold}
  aria-label={siteCopy.common.backToTopAria}
>
  <span class="rocket-tail" aria-hidden="true"></span>
  <svg viewBox="0 0 24 24" class="rocket-icon h-4.5 w-4.5 fill-none stroke-current stroke-[1.8]" aria-hidden="true">
    <path d="M14.5 3.5c1.9 1 3.4 2.5 4.4 4.4L13 13l-2.7.3.3-2.7 3.9-7.1z" />
    <path d="M8.4 10.8L5 14.2a2 2 0 000 2.8l2 2a2 2 0 002.8 0l3.4-3.4" />
    <path d="M6.6 17.4l-1.8 1.8M12.2 5.4l6.4 6.4" />
  </svg>
</button>

<script is:inline>
  (() => {
    const buttons = document.querySelectorAll('[data-back-to-top]')
    if (buttons.length === 0) {
      return
    }

    const sync = () => {
      const top = window.scrollY || document.documentElement.scrollTop || 0
      buttons.forEach((button) => {
        const thresholdValue = Number(button.getAttribute('data-threshold') || '360')
        button.classList.toggle('is-visible', top > thresholdValue)
      })
    }

    const scrollToTop = () => {
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
      window.scrollTo({ top: 0, behavior: prefersReducedMotion ? 'auto' : 'smooth' })
    }

    buttons.forEach((button) => {
      button.addEventListener('click', scrollToTop)
    })

    window.addEventListener('scroll', sync, { passive: true })
    window.addEventListener('resize', sync, { passive: true })
    sync()
  })()
</script>

<style>
  .back-to-top-rocket {
    opacity: 0;
    pointer-events: none;
    transform: translateY(10px);
    position: fixed;
    overflow: hidden;
  }

  .back-to-top-rocket.is-visible {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .back-to-top-rocket .rocket-icon {
    transition: transform 0.22s ease;
    transform-origin: 50% 60%;
  }

  .back-to-top-rocket:hover .rocket-icon {
    transform: translateY(-1px) rotate(-12deg);
  }

  .back-to-top-rocket .rocket-tail {
    position: absolute;
    left: 50%;
    bottom: 3px;
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: radial-gradient(circle at 50% 20%, rgba(250, 204, 21, 0.95), rgba(249, 115, 22, 0.9));
    transform: translateX(-50%);
    opacity: 0.65;
    transition: opacity 0.2s ease;
  }

  .back-to-top-rocket:hover .rocket-tail {
    opacity: 1;
    animation: rocket-tail-flame 0.5s ease-in-out infinite;
  }

  @keyframes rocket-tail-flame {
    0%, 100% {
      transform: translateX(-50%) scale(1, 0.9);
    }
    50% {
      transform: translateX(-50%) scale(1.12, 1.25);
    }
  }
</style>
