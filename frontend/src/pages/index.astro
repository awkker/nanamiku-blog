---
/**
 * 首页开屏页
 *
 * 这份页面本身只负责“拼装”首页的几个核心区块：
 * 1. 顶部品牌栏和右上角小组件
 * 2. 中央主视觉区（标题、副标题、背景视差）
 * 3. 底部 Dock 导航
 *
 * 设计上，这个页面尽量不自己处理复杂业务：
 * - 文案来自 `siteCopy`
 * - 主视觉内容交给 `HomeHeroIntro`
 * - 背景效果交给 `HeroParallax`
 * - 顶栏小组件交给 `HomeTopbarWidgets`
 * - 底部 Dock 交给 `HomeBottomDock`
 */
import BaseHead from '../components/base/BaseHead.astro'
import HomeHeroIntro from '../components/home/HomeHeroIntro.vue'
import HomeBottomDock from '../components/home/HomeBottomDock.vue'
import HomeTopbarWidgets from '../components/home/HomeTopbarWidgets.vue'
import HeroParallax from '../components/home/HeroParallax.vue'
import { siteCopy } from '../content/copy'
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <!-- 首页的 SEO 标题和描述统一走 BaseHead，避免页面里手写一堆 meta 标签。 -->
    <BaseHead title={siteCopy.home.metaTitle} description={siteCopy.home.metaDescription} />
  </head>
  <body class="overflow-hidden bg-slate-900 text-[#39c5bb]">
    <main class="relative h-screen w-screen overflow-hidden">
      <!-- 背景视差层放在最底部，用来提供首页的氛围感。 -->
      <HeroParallax client:load />

      <!--
        顶部栏负责两件事：
        1. 左侧展示品牌 logo 和站点名
        2. 右侧挂载时钟、天气之类的顶部小组件

        这里单独放在页面里，而不是立刻抽成通用 Header，
        是因为首页头部视觉和普通内容页头部通常差异很大。
      -->
      <header class="absolute left-0 top-0 z-20 flex h-8 w-full items-center justify-between border-b border-white/30 bg-white/35 px-2.5 text-sm font-medium text-[#39c5bb]/90 backdrop-blur-none min-[380px]:px-3 sm:px-4">
        <a
          href="/"
          class="inline-flex items-center gap-2 rounded-[18px] border border-white/45 bg-white/72 px-2.5 py-1 text-[13px] font-semibold tracking-[0.01em] text-slate-700 shadow-[0_8px_20px_rgba(15,23,42,0.1)] transition hover:border-miku/35 hover:text-miku"
        >
          <img
            src="/picture/logo-64.webp"
            alt={siteCopy.brand.logoAlt}
            data-site-logo-alt
            class="h-5 w-5 rounded-lg object-cover"
            width="20"
            height="20"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
          <span class="whitespace-nowrap" data-site-brand-text>{siteCopy.brand.text}</span>
        </a>

        <!-- 右上角的小组件交给独立 Vue 岛屿处理，避免首页页面本身塞太多交互逻辑。 -->
        <HomeTopbarWidgets client:load />
      </header>

      <!--
        中央主视觉区只负责“放置”主视觉组件，不负责主视觉内部的动画和数据读取。
        `HomeHeroIntro` 自己会去 store 里拿标题和副标题数据。
      -->
      <section class="relative z-10 flex h-full flex-col items-center justify-center px-4 text-center">
        <HomeHeroIntro client:load />
      </section>

      <!-- 底部 Dock 交给独立组件处理，页面只负责放置位置。 -->
      <HomeBottomDock client:load />
    </main>
  </body>
</html>

<style>
  /* `hero-title` 和 `hero-text` 虽然定义在页面里，
     但实际是给 `HomeHeroIntro.vue` 里的标题元素使用的。
     这样做的目的是把“首页独有的视觉语言”留在首页页面本身管理。

     也就是说：
     - 组件负责结构和交互
     - 页面负责首页专属视觉 */
  .hero-title {
    font-family: 'Noto Serif SC', 'Noto Serif JP', 'Songti SC', 'STSong', serif;
    font-weight: 700;
    line-height: 1.08;
    position: relative;
  }

  /* 标题内部的渐变文字效果。
     通过 background-clip + 位移动画，让主标题看起来更像首页开屏视觉，而不是普通正文标题。 */
  .hero-text {
    background: linear-gradient(
      90deg,
      #b4f0ea,
      #60e8dc 25%,
      #ffffff 50%,
      #60e8dc 75%,
      #b4f0ea
    );
    background-size: 200% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: gradient-flow 5s ease-in-out infinite alternate;
    position: relative;
    display: inline-block;
  }

  /* 渐变流动动画本身很简单，只负责推动背景渐变左右移动。 */
  @keyframes gradient-flow {
    0% { background-position: 0% 50%; }
    100% { background-position: 200% 50%; }
  }
</style>
