---
import BaseHead from '../../components/base/BaseHead.astro'
import AdminRouteGuard from '../../components/admin/AdminRouteGuard.astro'
import AdminPostsManager from '../../components/admin/AdminPostsManager.vue'
import AdminLayout from '../../layouts/AdminLayout.astro'
import { adminCopy } from '../../content/copy'

const copy = adminCopy.postsManager
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={copy.page.metaTitle} description={copy.page.metaDescription} />
    <AdminRouteGuard />
  </head>
  <body>
    <AdminLayout activeKey="posts" pageTitle="文章管理">
      <AdminPostsManager client:load />
    </AdminLayout>
  </body>
</html>
