---
import BaseHead from '../../components/base/BaseHead.astro'
import AdminProfileManager from '../../components/admin/AdminProfileManager.vue'
import AdminRouteGuard from '../../components/admin/AdminRouteGuard.astro'
import AdminLayout from '../../layouts/AdminLayout.astro'
import { adminCopy } from '../../content/copy'

const copy = adminCopy.profileManager
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={copy.page.metaTitle} description={copy.page.metaDescription} />
    <AdminRouteGuard />
  </head>
  <body>
    <AdminLayout activeKey="profile" pageTitle={adminCopy.sidebar.nav.profile}>
      <AdminProfileManager client:load />
    </AdminLayout>
  </body>
</html>
