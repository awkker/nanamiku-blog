---
import BaseHead from '../../components/base/BaseHead.astro'
import AdminDashboard from '../../components/admin/AdminDashboard.vue'
import AdminRouteGuard from '../../components/admin/AdminRouteGuard.astro'
import AdminLayout from '../../layouts/AdminLayout.astro'
import { adminCopy } from '../../content/copy'

const copy = adminCopy.layout
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={copy.page.metaTitle} description={copy.page.metaDescription} />
    <AdminRouteGuard />
  </head>
  <body>
    <AdminLayout activeKey="dashboard" pageTitle="仪表盘">
      <AdminDashboard client:load />
    </AdminLayout>
  </body>
</html>
