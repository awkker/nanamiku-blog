---
import BaseHead from '../../components/base/BaseHead.astro'
import BlogTopNav from '../../components/blog/BlogTopNav.astro'
import SiteFooter from '../../components/base/SiteFooter.vue'
import BlogPostView from '../../components/blog/BlogPostView.vue'
import { siteCopy } from '../../content/copy'
import { getReadingStats, renderPostMarkdown } from '../../lib/post-content'
import { getPublishedPostDetail, getPublishedPostSummaries, getRelatedPublishedPosts } from '../../lib/post-source'

export async function getStaticPaths() {
  const { data: posts } = await getPublishedPostSummaries()

  return posts.map((post) => ({
    params: {
      slug: post.slug,
    },
  }))
}

const slug = Astro.params.slug || ''
const { data: post } = await getPublishedPostDetail(slug)

if (!post) {
  throw new Error(`Post not found for slug "${slug}"`)
}

const relatedPosts = await getRelatedPublishedPosts(slug, 3)
const rendered = await renderPostMarkdown(post.content_markdown || '')
const stats = getReadingStats(post.content_markdown || post.excerpt || '')
const pageTitle = `${post.title} | ${siteCopy.seo.siteTitle}`
const pageDescription = post.excerpt || siteCopy.seo.defaultDescription
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead
      title={pageTitle}
      description={pageDescription}
      image={post.hero_image_url || siteCopy.seo.defaultSocialImage}
      type="article"
      publishedTime={post.published_at || post.created_at}
      modifiedTime={post.updated_at}
      tags={(post.tags || []).map((tag) => tag.name)}
    />
  </head>
  <body class="bg-slate-50 text-slate-800">
    <BlogTopNav currentPath={Astro.url.pathname} />
    <main class="relative min-h-screen px-4 pb-20 pt-20 sm:px-6 lg:px-8">
      <div class="blog-post-view-background pointer-events-none fixed inset-0 -z-10 bg-[radial-gradient(circle_at_top,rgba(57,197,187,0.12),transparent_50%),radial-gradient(circle_at_85%_18%,rgba(192,132,252,0.08),transparent_40%),linear-gradient(180deg,#f8fafc_0%,#eef2ff_100%)]" />
      <BlogPostView
        client:load
        initialSlug={slug}
        initialPost={post}
        initialRelatedPosts={relatedPosts}
        initialRenderedContent={rendered.html}
        initialTocHeadings={rendered.headings}
        initialWordCount={stats.wordCount}
        initialReadingMinutes={stats.readingMinutes}
      />
    </main>

    <SiteFooter client:load />
  </body>
</html>

<style is:global>
  html.theme-night .blog-post-view-background {
    background:
      radial-gradient(circle at top, rgba(57, 197, 187, 0.12), transparent 48%),
      radial-gradient(circle at 85% 18%, rgba(192, 132, 252, 0.1), transparent 40%),
      linear-gradient(180deg, #0b1220 0%, #0a1020 45%, #060b16 100%) !important;
  }
</style>
