---
import BaseHead from '../components/base/BaseHead.astro'
import LiquidGlassCard from '../components/ui/LiquidGlassCard.vue'
import { siteCopy } from '../content/copy'

const copy = siteCopy.notFoundPage
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={copy.metaTitle} description={copy.metaDescription} />
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-800">
    <main class="relative min-h-screen overflow-hidden px-4 py-8 sm:px-6 lg:px-8">
      <div class="pointer-events-none absolute inset-0">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_8%_14%,rgba(57,197,187,0.24),transparent_42%),radial-gradient(circle_at_82%_12%,rgba(192,132,252,0.2),transparent_38%),linear-gradient(160deg,#f8fbff_0%,#eef6ff_52%,#f8fafc_100%)]" />
        <div class="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.38)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.42)_1px,transparent_1px)] bg-[size:26px_26px] opacity-70" />
        <div class="absolute -left-14 top-20 h-56 w-56 rounded-full bg-miku/20 blur-3xl" />
        <div class="absolute right-0 top-10 h-48 w-48 rounded-full bg-[#c084fc]/18 blur-3xl" />
        <div class="absolute bottom-8 left-1/2 h-44 w-44 -translate-x-1/2 rounded-full bg-miku/12 blur-2xl" />
      </div>

      <header class="relative z-10 mx-auto max-w-[1120px]">
        <a
          href="/"
          class="inline-flex items-center gap-2 rounded-xl border border-white/70 bg-white/62 px-3 py-2 text-xs font-semibold tracking-[0.16em] text-slate-600 shadow-[0_8px_24px_rgba(15,23,42,0.08)]"
        >
          <img src="/picture/logo-64.webp" alt={siteCopy.brand.logoAlt} class="h-4 w-4 rounded-sm object-cover" width="16" height="16" loading="eager" decoding="async" />
          <span>{siteCopy.brand.text}</span>
        </a>
      </header>

      <section class="relative z-10 mx-auto flex min-h-[calc(100vh-8rem)] max-w-[1120px] items-center justify-center">
        <LiquidGlassCard client:load width="100%" maxWidth="1000px" padding="28px" borderRadius={30}>
          <div class="grid gap-8 lg:grid-cols-[1.05fr_0.95fr] lg:items-end">
            <div class="space-y-6">
              <p class="inline-flex animate-fade-up rounded-full border border-white/70 bg-white/58 px-3 py-1 text-xs tracking-[0.2em] text-slate-500">
                {copy.badge}
              </p>

              <h1 class="animate-fade-up bg-gradient-to-r from-slate-900 via-miku to-[#c084fc] bg-clip-text text-[clamp(2.1rem,5.2vw,4rem)] font-black leading-[1.12] tracking-tight text-transparent [animation-delay:80ms]">
                {copy.title}
              </h1>

              <p class="max-w-2xl animate-fade-up text-base leading-relaxed text-slate-600 [animation-delay:120ms] sm:text-lg">
                {copy.description}
              </p>

              <div class="animate-fade-up rounded-2xl border border-white/70 bg-white/55 p-4 [animation-delay:160ms]">
                <p class="text-xs tracking-[0.16em] text-slate-500">{copy.hintsTitle}</p>
                <ul class="mt-3 grid gap-2.5">
                  {
                    copy.hints.map((hint, index) => (
                      <li class="flex items-start gap-2 text-sm text-slate-600">
                        <span class:list={['mt-[6px] h-1.5 w-1.5 rounded-full', index === 1 ? 'bg-[#c084fc]/80' : 'bg-miku/80']} />
                        <span>{hint}</span>
                      </li>
                    ))
                  }
                </ul>
              </div>

              <div class="flex flex-wrap gap-2.5">
                {
                  copy.actions.map((action, index) => (
                    <a
                      href={action.href}
                      aria-label={action.ariaLabel}
                      class:list={[
                        'inline-flex items-center rounded-xl border px-4 py-2.5 text-sm font-semibold transition hover:-translate-y-0.5 animate-fade-up',
                        index === 0
                          ? 'border-miku/45 bg-miku-soft text-miku hover:border-miku/65'
                          : index === 1
                            ? 'border-[#c084fc]/40 bg-[#f3e8ff] text-[#8b5cf6] hover:border-[#c084fc]/65'
                            : 'border-slate-200 bg-white/70 text-slate-600 hover:border-slate-300',
                        index === 0 ? '[animation-delay:220ms]' : index === 1 ? '[animation-delay:260ms]' : '[animation-delay:300ms]',
                      ]}
                    >
                      {action.label}
                    </a>
                  ))
                }
                <button
                  type="button"
                  data-go-back
                  aria-label={copy.backActionAria}
                  class="inline-flex items-center rounded-xl border border-slate-200 bg-white/60 px-4 py-2.5 text-sm font-semibold text-slate-500 transition hover:-translate-y-0.5 hover:border-miku/40 hover:text-miku animate-fade-up [animation-delay:340ms]"
                >
                  {copy.backActionLabel}
                </button>
              </div>
            </div>

            <div class="space-y-4 rounded-3xl border border-white/70 bg-white/52 p-5 shadow-[0_20px_45px_rgba(15,23,42,0.12)]">
              <p class="text-xs tracking-[0.2em] text-slate-500">{copy.codeLabel}</p>
              <p class="bg-gradient-to-r from-miku via-[#7cddff] to-[#c084fc] bg-clip-text text-[clamp(4rem,18vw,8.5rem)] font-black leading-[0.9] text-transparent">
                {copy.codeValue}
              </p>

              <div class="rounded-2xl border border-white/75 bg-white/68 p-4">
                <p class="text-xs tracking-[0.18em] text-slate-500">{copy.quickLinksTitle}</p>
                <div class="mt-3 flex flex-wrap gap-2">
                  {
                    copy.quickLinks.map((link) => (
                      <a
                        href={link.href}
                        class="rounded-lg border border-white/70 bg-white/80 px-3 py-1.5 text-xs font-semibold text-slate-600 transition hover:border-miku/45 hover:text-miku"
                      >
                        {link.label}
                      </a>
                    ))
                  }
                </div>
              </div>

              <p class="text-xs tracking-[0.24em] text-slate-400">{copy.panelFootnote}</p>
            </div>
          </div>
        </LiquidGlassCard>
      </section>
    </main>
  </body>
</html>

<script is:inline>
  const backButton = document.querySelector('[data-go-back]');

  backButton?.addEventListener('click', () => {
    if (window.history.length > 1) {
      window.history.back();
      return;
    }

    window.location.assign('/');
  });
</script>
