# Docker Compose production template for BaoTa reverse proxy
# Copy this file to `.env` at the repo root, then replace the placeholder values.

# Public site URL used by frontend build (sitemap / canonical / rss site URL).
SITE_URL=https://your-domain.com

# Compose-exposed local ports for BaoTa reverse proxy.
FRONTEND_PORT=4321
BACKEND_PORT=8080

# Server
APP_ENV=production

# PostgreSQL
DB_USER=miku
DB_PASSWORD=change-this-postgres-password
DB_NAME=miku_blog

# Redis
REDIS_PASSWORD=change-this-redis-password

# JWT
JWT_SECRET=change-this-to-a-long-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# Session cookies
# Leave COOKIE_DOMAIN empty if BaoTa serves the site from a single host like `blog.example.com`.
# Set it to `.example.com` only when you really need cross-subdomain cookies.
COOKIE_DOMAIN=
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# CORS
# Keep this aligned with the final public origin handled by BaoTa.
CORS_ORIGINS=https://your-domain.com

# Optional runtime settings
WEATHER_LOCATION=Shanghai
GEOIP_DB_PATH=
